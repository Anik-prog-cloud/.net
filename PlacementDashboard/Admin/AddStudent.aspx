<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AddStudent.aspx.cs" Inherits="PlacementDashboard.Admin.AddStudent" %><!DOCTYPE html><html><head runat="server"><title>Add Student</title><link href="../Content/Style.css" rel="stylesheet" /></head><body><form runat="server"><nav><a href="Dashboard.aspx">Dashboard</a><a href="ViewStudents.aspx">Students</a></nav><main><h1>Add Student</h1><asp:ValidationSummary runat="server" CssClass="error"/><label>Name</label><asp:TextBox ID="StudentName" runat="server"/><asp:RequiredFieldValidator runat="server" ControlToValidate="StudentName" ErrorMessage="Name is required"/><label>Department</label><asp:TextBox ID="Department" runat="server"/><asp:RequiredFieldValidator runat="server" ControlToValidate="Department" ErrorMessage="Department is required"/><label>Company</label><asp:TextBox ID="Company" runat="server"/><label>Package</label><asp:TextBox ID="Package" runat="server"/><label>Status</label><asp:DropDownList ID="Status" runat="server"><asp:ListItem>Placed</asp:ListItem><asp:ListItem>Not Placed</asp:ListItem></asp:DropDownList><asp:Button ID="Save" runat="server" Text="Save" OnClick="Save_Click"/><asp:Label ID="Message" runat="server" CssClass="message"/></main></form></body></html>
