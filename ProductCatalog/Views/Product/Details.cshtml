@model ProductCatalog.Models.Product

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .details { max-width:700px; padding:12px; }
    .details h2 { margin-top:0; }
    .meta { color:#666; margin-bottom:8px; }
    .btn { display:inline-block; padding:6px 10px; background:#6c757d; color:#fff; text-decoration:none; border-radius:4px; }
</style>

<div class="details">
    <h2>@Model.Name</h2>
    <div class="meta">ID: @Model.Id</div>
    <div><strong>Category:</strong> @Model.Category</div>
    <div><strong>Price:</strong> ₹@Model.Price</div>
    <div style="margin-top:8px;"><strong>Description:</strong> @Model.Description</div>

    <p style="margin-top:12px">@Html.ActionLink("Back to Products", "Index", "Product", null, new { @class = "btn" })</p>
</div>
